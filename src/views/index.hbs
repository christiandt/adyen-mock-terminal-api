<main class="app">
    <section class="stage" aria-label="Terminal">
        <div class="terminal-area">
        <div id="terminal-section" class="terminal">
            <div class="terminal-top">
                <div class="screen" aria-live="polite">
                    <span id="screen-amount" class="screen-amount"></span>
                    <span id="screen">Ready</span>
                    <span id="screen-hint" class="screen-hint">Send Terminal API requests to <code>/sync</code></span>
                    <span id="screen-pin" class="screen-pin hidden"></span>
                </div>
            </div>
            <div class="terminal-bottom">
                <div class="digits">
                    <button id="1-button" class="digit-button">1</button>
                    <button id="2-button" class="digit-button">2</button>
                    <button id="3-button" class="digit-button">3</button>
                    <button id="cancel-button" class="action-button red" aria-label="Cancel">X</button>

                    <button id="4-button" class="digit-button">4</button>
                    <button id="5-button" class="digit-button">5</button>
                    <button id="6-button" class="digit-button">6</button>
                    <button id="clear-button" class="action-button yellow" aria-label="Correct">&lt;</button>

                    <button id="7-button" class="digit-button">7</button>
                    <button id="8-button" class="digit-button">8</button>
                    <button id="9-button" class="digit-button">9</button>
                    <button id="confirm-button" class="action-button green">✓</button>

                    <button id="star-button" class="digit-button">*</button>
                    <button id="0-button" class="digit-button">0</button>
                    <button id="hashtag-button" class="digit-button">#</button>
                </div>
            </div>
        </div>
        </div>

        <aside id="device-panel" class="device-panel">
            <button type="button" id="device-panel-toggle" class="device-panel-toggle" aria-expanded="true" aria-controls="device-panel-body">
                <span id="device-panel-light" class="device-light" aria-hidden="true"></span>
                <span id="device-panel-toggle-text">Hide</span>
            </button>
            <div id="device-panel-body" class="device-panel-body">
                <div class="device-row">
                    <span id="device-state-light" class="device-light" aria-hidden="true"></span>
                    <span class="device-label">Terminal <strong id="device-state" aria-live="polite">ready</strong></span>
                </div>
                <label class="device-option">
                    <input type="checkbox" id="auto-confirm-checkbox"> Auto-confirm PIN
                </label>
                <label class="device-option device-option-indent">
                    after <input type="number" id="auto-confirm-delay" min="0" max="60000" step="100" class="device-number"> ms
                </label>
                <label class="device-option">
                    Card <select id="card-select" class="device-select"></select>
                </label>
                <label class="device-option device-option-indent">
                    last digits <input type="text" id="card-last4" inputmode="numeric" maxlength="4" placeholder="card's own" class="device-number">
                </label>
                <details class="connect">
                    <summary>Connect your POS: <code id="connect-url"></code></summary>
                    <p>Send Terminal API requests (<code>SaleToPOIRequest</code>) as JSON with <code>POST</code> to this URL, as you would to Adyen's <code>/sync</code> endpoint.</p>
                </details>
            </div>
        </aside>
    </section>

    <aside id="messages-pane" class="messages-pane">
        <div class="messages-header">
            <h1 class="messages-title">Messages</h1>
            <button type="button" id="messages-toggle" class="pane-toggle" aria-expanded="true" aria-controls="messages-body">Hide</button>
        </div>
        <div id="messages-body" class="messages-body">
            <div class="send-row">
                <label for="request-dropdown" class="visually-hidden">Sample request</label>
                <select id="request-dropdown" class="request-dropdown">
                    {{#each keys}}
                        {{#if (isEqual this "payment")}}
                            <option value="{{this}}" selected>{{toUpperCase this}} Request</option>
                        {{else}}
                            <option value="{{this}}">{{toUpperCase this}} Request</option>
                        {{/if}}
                    {{/each}}
                </select>
                <button id="send-button" class="button primary">Send</button>
                <button id="clear-codeblock-button" class="button">Clear</button>
            </div>
            <ol id="message-list" class="message-list" aria-live="polite"></ol>
            <p id="message-empty" class="message-empty">No messages yet. Requests to <code>/sync</code> appear here.</p>
        </div>
    </aside>
</main>

<script src="/js/http/http-client.js"></script>
<script src="/js/terminal.js"></script>
<script src="/js/messages.js"></script>
<script src="/js/device-panel.js"></script>
